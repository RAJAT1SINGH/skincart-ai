# Copy to a local .env file and replace placeholders as needed. Never commit real secrets.

# Spring Boot
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/skincart
DATABASE_USERNAME=replace-with-local-database-user
DATABASE_PASSWORD=replace-with-local-database-password

# YouCam settings are backend-only. Keep mock mode enabled until official API details
# and credentials are supplied. Leave provider settings empty in mock mode.
YOUCAM_MOCK=true
YOUCAM_API_BASE_URL=
YOUCAM_API_KEY=

# Frontend may use this URL; never put provider credentials in frontend variables.
VITE_API_BASE_URL=http://localhost:8080/api
